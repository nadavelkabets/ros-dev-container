{%- set ardupilot_minor = ardupilot_version.split('.')[1] | int -%}
{%- set ubuntu_version = '20.04' if ardupilot_minor < 4 else ('22.04' if ardupilot_minor < 6 else '24.04') -%}
# ArduPilot SITL. It doesn't use ROS, so its Ubuntu release follows what this ArduPilot version supports, whatever
# the ROS distribution.
FROM ubuntu:{{ ubuntu_version }}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    ca-certificates \
    git \
    lsb-release \
    sudo \
    tzdata

ARG USER_NAME=ardupilot
ARG USER_UID=1000
# Ubuntu 24.04+ base images ship an "ubuntu" user that already owns UID 1000
RUN if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && useradd --uid "$USER_UID" --create-home --shell /bin/bash "$USER_NAME" \
    && echo "$USER_NAME ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/$USER_NAME" \
    && chmod 0440 "/etc/sudoers.d/$USER_NAME"

COPY scripts/simulation/sitl_entrypoint.sh /sitl_entrypoint.sh

USER $USER_NAME
WORKDIR /home/$USER_NAME

# The Copter release picked when generating the project. Not master: its SITL ignores the gazebo-iris frame's default
# parameters, so the vehicle can't arm in Gazebo.
ARG ARDUPILOT_VERSION=Copter-{{ ardupilot_version }}
RUN git clone --depth 1 --branch "$ARDUPILOT_VERSION" --recurse-submodules --shallow-submodules \
    https://github.com/ArduPilot/ardupilot.git
WORKDIR /home/$USER_NAME/ardupilot
# The script adds $USER to the dialout group, and docker doesn't set USER
RUN USER=$USER_NAME SKIP_AP_EXT_ENV=1 SKIP_AP_GRAPHIC_ENV=1 SKIP_AP_COV_ENV=1 SKIP_AP_GIT_CHECK=1 \
    Tools/environment_install/install-prereqs-ubuntu.sh -y
RUN . ~/.ardupilot_env && ./waf configure --board sitl && ./waf copter

ENTRYPOINT ["/sitl_entrypoint.sh"]
CMD ["bash"]
