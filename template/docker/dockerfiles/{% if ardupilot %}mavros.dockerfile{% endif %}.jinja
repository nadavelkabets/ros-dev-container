FROM ros:{{ ros_distro }}-ros-base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The upgrade keeps the base image's ROS packages in step with the ones installed here (ROS releases them in syncs)
RUN apt-get update && apt-get dist-upgrade -y && apt-get install -y ros-{{ ros_distro }}-mavros \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN /ros_entrypoint.sh ros2 run mavros install_geographiclib_datasets.sh

ENTRYPOINT ["/ros_entrypoint.sh", "ros2", "run", "mavros", "mavros_node"]
