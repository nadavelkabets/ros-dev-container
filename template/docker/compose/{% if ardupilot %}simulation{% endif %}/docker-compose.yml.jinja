name: {{ project_slug }}
{%- if ardupilot_gazebo %}

# Gazebo and SITL run the same image
x-gazebo-image: &gazebo-image
  build:
    context: ../../..
    dockerfile: docker/dockerfiles/gazebo.dockerfile
  image: {{ project_slug }}-gazebo
{%- endif %}

services:
{%- if ardupilot_gazebo %}
  gazebo:
    <<: *gazebo-image
    container_name: gazebo
    environment:
      - DISPLAY=${DISPLAY}
      # Qt's X11 shared memory doesn't work across containers
      - QT_X11_NO_MITSHM=1
    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix
{%- if gazebo_vm_rendering %}
    # Renders on the host's GPU. The group ids are written to .env next to this file by
    # scripts/dev_container/initialize.sh, which runs on the host before the dev container starts.
    devices:
      - /dev/dri:/dev/dri
    group_add:
      - "${RENDER_GID:-0}"
      - "${VIDEO_GID:-0}"
{%- endif %}
    command:
      - gz
      - sim
      - -r
      - iris_runway.sdf
{%- if gazebo_vm_rendering %}
      # Ogre 2 (the default) doesn't work in VMs such as VMware Fusion or Parallels on Apple Silicon
      - --render-engine
      - ogre
{%- endif %}
    networks:
      dev:
        # SITL shares this container's network, so MAVROS reaches it here
        aliases:
          - sitl

  sitl:
    <<: *gazebo-image
    container_name: sitl
    depends_on:
      - gazebo
    # The ardupilot_gazebo plugin and SITL talk over 127.0.0.1
    network_mode: service:gazebo
    stdin_open: true
    tty: true
    command:
      - sim_vehicle.py
      - -v
      - ArduCopter
      - -f
      - gazebo-iris
      - --model
      - JSON
      - --no-rebuild
      - --no-mavproxy
      - -l
      - 31.4993848,34.8041511,0,0
{%- else %}
  sitl:
    build:
      context: ../../..
      dockerfile: docker/dockerfiles/sitl.dockerfile
    container_name: sitl
    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix
      - sitl_eeprom_cache:/ardupilot/eeprom.bin
    environment:
      - DISPLAY=${DISPLAY}
    privileged: true
    stdin_open: true
    tty: true
    command:
      - sim_vehicle.py
      - -v
      - ArduCopter
      - --map
      - --console
      - --no-rebuild
      - --no-mavproxy
      - -l
      - 31.4993848,34.8041511,0,0
    networks:
      - dev
{%- endif %}

  mission_planner:
    build:
      context: ../../..
      dockerfile: docker/dockerfiles/mission_planner.dockerfile
    container_name: mission_planner
    environment:
      - DISPLAY=${DISPLAY}
    privileged: true
    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix
    networks:
      - dev

  mavros:
    build:
      context: ../../..
      dockerfile: docker/dockerfiles/mavros.dockerfile
    container_name: mavros
    command:
      - --ros-args
      - -p
      - fcu_url:=tcp://sitl:5760/
      - -p
      - gcs_url:=udp://@mission_planner:14550/
    networks:
      - dev

networks:
  dev:
    driver: bridge
{%- if not ardupilot_gazebo %}

volumes:
  sitl_eeprom_cache:
{%- endif %}
