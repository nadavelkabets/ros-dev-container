name: {{ project_slug }}

services:
  sitl:
    build:
      context: ../../..
      dockerfile: docker/dockerfiles/sitl.dockerfile
    stdin_open: true
    tty: true
    command:
      - sim_vehicle.py
      - -v
      - ArduCopter
      - --no-rebuild
      - --no-mavproxy
      - -l
      - 31.4993848,34.8041511,0,0
    networks:
      - dev

  mission-planner:
    build:
      context: ../../..
      dockerfile: docker/dockerfiles/mission_planner.dockerfile
    environment:
      - DISPLAY=${DISPLAY}
    privileged: true
    volumes:
      - /tmp/.X11-unix:/tmp/.X11-unix
    networks:
      - dev

  mavros:
    build:
      context: ../../..
      dockerfile: docker/dockerfiles/mavros.dockerfile
    command:
      - --ros-args
      - -p
      - fcu_url:=tcp://sitl:5760/
      - -p
      - gcs_url:=udp://@mission-planner:14550/
    networks:
      - dev

networks:
  dev:
    driver: bridge
