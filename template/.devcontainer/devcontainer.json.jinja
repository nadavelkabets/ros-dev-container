{%- set extensions = [
  "charliermarsh.ruff",
  "editorconfig.editorconfig",
  "ms-python.mypy-type-checker",
  "ms-python.python",
  "ms-python.vscode-pylance",
  "ranch-hand-robotics.rde-pack",
  "timonwong.shellcheck",
] + vscode_extensions + (["anthropic.claude-code"] if claude_code else []) -%}
{
  "name": "{{ project_name }}",
  "dockerComposeFile": "docker-compose.yml",
  "service": "development-environment",
  // Keeps the container running with the Dev Containers loop, which, unlike `sleep infinity`, exits right away on
  // docker stop
  "overrideCommand": true,
  "workspaceFolder": "/home/user/workspace",
  "containerUser": "user",
{%- if docker_access %}
  // Installs the docker CLI and gives the container user access to the host's docker socket
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // The workspace's path on the host, for bind mounts in containers started from inside
  "containerEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
{%- endif %}
  // VS Code takes its environment (ROS, the workspace overlay, the uv venv) from ~/.bashrc through this probe
  "userEnvProbe": "loginInteractiveShell",
  // VS Code waits for it before connecting, but runs the probe before it, so extensions only see what it creates
  // after a window reload
  "onCreateCommand": "./.devcontainer/on_create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
{%- for extension in extensions %}
        "{{ extension }}"{{ "," if not loop.last }}
{%- endfor %}
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        "python.defaultInterpreterPath": "{{ '/home/user/workspace/.venv/bin/python' if uv_venv else '/usr/bin/python3' }}",
{%- if uv_venv %}
        // ~/.bashrc already activates the venv. Otherwise the Python extension also types its activate command into
        // every terminal.
        "python-envs.terminal.autoActivationType": "off",
{%- endif %}
        "python.terminal.useEnvFile": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true,
        "python.analysis.autoImportCompletions": true,
        // Pylance already finds ROS through the environment. When these are empty, the ROS extension writes a snapshot
        // of PYTHONPATH into .vscode/settings.json, which goes stale. The workspace root is a harmless non-empty value.
        "python.analysis.extraPaths": ["${workspaceFolder}"],
        "python.autoComplete.extraPaths": ["${workspaceFolder}"],
{%- if "ms-vscode.cpptools-extension-pack" in vscode_extensions %}
        // colcon merges each package's compile commands into this file (just build exports them)
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
{%- endif %}
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.mypy_cache": true,
          "**/.ruff_cache": true
        },
        "files.autoSaveDelay": 300,
        "files.autoSave": "afterDelay",
        "files.insertFinalNewline": true
      }
    }
  }
}
