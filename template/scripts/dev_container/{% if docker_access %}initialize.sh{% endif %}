#!/bin/bash
# Runs on the host before the dev container starts (devcontainer.json initializeCommand). Writes host group ids
# for docker compose, which adds them to the containers (group_add): the docker socket's for the dev container,
# and the GPU's for the simulation.
set -euo pipefail

cd "$(dirname "$0")/../.."
echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >docker/compose/dev_container/.env

if [ -d docker/compose/simulation ]; then
  # Group ids of the host's GPU device nodes, for simulation containers that render through /dev/dri
  printf 'RENDER_GID=%s\nVIDEO_GID=%s\n' "$(getent group render | cut -d: -f3)" "$(getent group video | cut -d: -f3)" \
    >docker/compose/simulation/.env
fi
