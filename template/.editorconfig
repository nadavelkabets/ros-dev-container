root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,toml,xml,yaml,yml}]
indent_size = 2

# Google shell style, also used by shfmt
[*.sh]
indent_size = 2
switch_case_indent = true
binary_next_line = true
